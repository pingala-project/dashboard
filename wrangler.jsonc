{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pingala-dashboard",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://pingala-dashboard.pages.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pingala-dashboard",
      "database_id": "cc7661da-cf18-4074-81df-260fb98c25b0",
      "migrations_dir": "./migrations"
    }
  ]
}
